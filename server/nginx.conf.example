# dsh-codebuddy 心跳接收端 —— Nginx 反代示例
#
# 用途：把 http 换成 https，并隐藏端口。
# 放到 /etc/nginx/conf.d/cb-stats.conf，然后 nginx -t && systemctl reload nginx
#
# 把 stats.example.com 换成你自己的域名（需要先解析到这台服务器）。
# 如果只是想先用 IP:端口，这个文件可以完全不用。

server {
    listen 80;
    server_name stats.example.com;

    # 上 HTTPS 后把上面这行注释掉、下面这块取消注释
    # （推荐用 certbot 自动配置：certbot --nginx -d stats.example.com）

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 注意：后端不读取也不记录这个头，这里只是为了常规代理语义完整
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # 上报端点单独放宽一点限流之外的限制
    location = /hb {
        proxy_pass http://127.0.0.1:8787/hb;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 8k;
    }

    # 仪表盘建议只让自己访问；也可以用 Nginx 再叠一层 basic auth
    # location = / {
    #     auth_basic "stats";
    #     auth_basic_user_file /etc/nginx/.htpasswd;
    #     proxy_pass http://127.0.0.1:8787/;
    # }
}
